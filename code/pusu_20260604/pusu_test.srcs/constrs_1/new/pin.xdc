set_property IOSTANDARD LVCMOS33 [get_ports {GPIO_LMX2572_tri_o[*]}]

# LMX2572 GPIO: channel 2 inputs are MUXOUT lock detect for devices 0/1/2.
set_property PACKAGE_PIN R14 [get_ports {GPIO_LMX2572_MUX_tri_i[0]}]
set_property PACKAGE_PIN T12 [get_ports {GPIO_LMX2572_MUX_tri_i[1]}]
