# LTC2208 LVDS data clock and overflow
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets system_i/LTC2208_0/inst/m_axis_aclk]
set_property PACKAGE_PIN H16 [get_ports clkout_p_0]
set_property PACKAGE_PIN H17 [get_ports clkout_n_0]
set_property PACKAGE_PIN F16 [get_ports of_p_0]
set_property PACKAGE_PIN F17 [get_ports of_n_0]
set_property IOSTANDARD LVDS_25 [get_ports {clkout_p_0 clkout_n_0 of_p_0 of_n_0}]

# LTC2208 single-ended controls, Bank 35, 2.5 V
set_property PACKAGE_PIN J16 [get_ports {GPIO_LTC2208_CTRL_tri_o[0]}]
